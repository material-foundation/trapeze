{
  "private": true,
  "name": "trapeze-demos",
  "version": "0.0.0",
  "scripts": {
    "start": "yarn run -TB wireit",
    "build": "yarn run -TB wireit",
    "build:tsc": "yarn run -TB wireit",
    "build:gen-html": "yarn run -TB wireit",
    "build:site": "yarn run -TB wireit"
  },
  "wireit": {
    "start": {
      "service": true,
      "command": "vite serve",
      "files": [
        "vite.config.js"
      ]
    },
    "build": {
      "dependencies": [
        "build:tsc",
        "build:gen-html",
        "build:site"
      ]
    },
    "build:tsc": {
      "command": "tsc --build --pretty",
      "files": [
        "src/**/*.{ts,tsx}",
        "tsconfig.json",
        "../../tsconfig.common.json"
      ],
      "output": [
        "dist/**/*.js",
        ".tsbuildinfo"
      ],
      "packageLocks": [
        "yarn.lock"
      ],
      "dependencies": [
        "../core:build"
      ]
    },
    "build:gen-html": {
      "command": "sed 's/mount.tsx/mount.js/' src/index.html > dist/index.html",
      "files": [
        "src/index.html"
      ],
      "output": [
        "dist/index.html"
      ],
      "dependencies": [
        "build:tsc"
      ]
    },
    "build:site": {
      "command": "vite build",
      "clean": true,
      "files": [
        "dist/**/index.html",
        "dist/**/*.js",
        "vite.config.js"
      ],
      "output": [
        "site/**/*",
        ".tsbuildinfo"
      ],
      "packageLocks": [
        "yarn.lock"
      ],
      "dependencies": [
        "build:tsc",
        "build:gen-html"
      ]
    }
  },
  "dependencies": {
    "@jsxstyle/core": "3.0.2",
    "@jsxstyle/preact": "3.0.2",
    "@preact/signals": "1.2.0",
    "preact": "10.18.2",
    "trapeze": "workspace:*",
    "tslib": "2.4.0"
  },
  "author": "The Trapeze Authors (see AUTHORS)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/material-foundation/trapeze/issues"
  },
  "homepage": "https://github.com/material-foundation/trapeze"
}
